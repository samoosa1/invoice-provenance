# invoice-provenance api settings. Read by app/settings.py on startup.
# This file is gitignored (.env in the repo root .gitignore). Never commit it.
# Restart uvicorn after editing.

# Postgres connection. Format:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# If the password contains @ : / or # it must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# Local Homebrew Postgres (current default, no password):
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/invoice_provenance
# Hosted example (Oracle VM / Neon / other), replace every CAPITAL word:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Shared workspace token. Sent by the browser as X-Workspace-Token.
# Generate one with:  openssl rand -hex 32
WORKSPACE_TOKEN=dev-token-change-me

# "dev" allows the default token above. Anything else (e.g. "prod") refuses to start on it.
APP_ENV=dev
